{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AnimeDesk",
  "version": "0.4.2",
  "identifier": "com.animedesk.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5190",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5190 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnimeDesk — Anime & Manga Tracker",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/**/*"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:animedesk.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
